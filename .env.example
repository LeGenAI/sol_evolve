OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_SEARCH_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.1
# Optional cost override in USD per 1M tokens. If unset, SolEvolve
# tries OpenRouter's public /models pricing metadata for estimates.
SOLEVOLVE_PROMPT_COST_PER_1M=
SOLEVOLVE_COMPLETION_COST_PER_1M=
SOLEVOLVE_DISABLE_OPENROUTER_PRICING=false

SOLEVOLVE_MAX_TURNS=6
SOLEVOLVE_ARTIFACT_DIR=artifacts
SOLEVOLVE_SOLVER=cadical
KISSAT_PATH=./kissat/build/kissat
CADICAL_PATH=/path/to/cadical

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=solevolve-repro
LANGCHAIN_CALLBACKS_BACKGROUND=false
SOLEVOLVE_STRICT_TRACING=false

SOLEVOLVE_TRACE_TAGS=revision,reproducibility,github
# Set to ternary_bch_d9, gf4_hermitian, gf5_so, or all_so_table to let the
# schema-gated Evolver ask the coordinator to query codetables and run proof checks.
SOLEVOLVE_PAPER_CLAIM_ID=
SOLEVOLVE_PAPER_CLAIM_TIMEOUT=300
